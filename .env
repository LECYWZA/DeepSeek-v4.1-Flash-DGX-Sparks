NCCL_IB_MERGE_NICS=1
# DeepSeek-V4.1-Flash on 3x DGX Spark - this fleet's deployment profile.
# Gloo over the K2P LAN (192.168.123.x); SSH and NFS over the QSFP direct links.

# --- cluster ---
HEAD_IP=192.168.123.103
WORKER1_IP=192.168.123.109
WORKER1_HOST=192.168.100.2
WORKER2_IP=192.168.123.232
WORKER2_HOST=192.168.101.3
WORKER_USER=root
SSH_IDENTITY=$HOME/.ssh/id_ed25519

# --- fabric (ConnectX-7 RoCE triangle) ---
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enP7s7
NCCL_SOCKET_IFNAME=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=WARN
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=/usr/local/lib

# --- model / image ---
MODEL_DIR=$HOME/NewModels/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
IMAGE=dsv41-3x-spark:local
PORT=8888

# --- weights on spark2/spark3 (NFSv4 over QSFP direct) ---
NFS_SHARE=1
NFS_VOLUME=dsv41-weights
NFS_EXPORT_NAME=dsv41-native
NFS_SERVER_IP_1=192.168.100.1
NFS_SERVER_IP_2=192.168.101.1
NFS_CLIENTS=192.168.100.0/24,192.168.101.0/24,192.168.123.109,192.168.123.232

# --- parallelism (3 Sparks) ---
NNODES=3
TP_SIZE=3
EP_SIZE=3
DIST_PORT=20000

# --- serving ---
OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=0
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=4
DSV41_STATS_SECONDS=60
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.95
HEAD_MEM_FRACTION_STATIC=0.95
MAX_RUNNING_REQUESTS=4
CHUNKED_PREFILL_SIZE=1024
MAX_TOTAL_TOKENS=2400000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json
API_KEY=luojiecong
MAX_PREFILL_TOKENS=2560

# --- engram local shards ---
ENGRAM_DIR=$HOME/dsv41-engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# --- kernels (GB10 / SM121) ---
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800"
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=2560

